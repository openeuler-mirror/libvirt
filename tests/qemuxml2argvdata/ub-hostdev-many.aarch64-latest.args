-device '{"driver":"vfio-ub","host":"cc08-a000-0-2-000000-0000000000000016","id":"hostdev15","guid":"cc08-a000-0-2-000000-0000000000000016","eid":18,"portnum":1,"port0":"ubc.1:15","iommufd":"iommufd1"}' \
-sandbox on,obsolete=deny,elevateprivileges=deny,spawn=deny,resourcecontrol=deny \
