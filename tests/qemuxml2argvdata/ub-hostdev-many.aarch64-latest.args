-device '{"driver":"vfio-ub","host":"cc08-a000-0-2-000000-0000000000000008","id":"hostdev7","guid":"cc08-a000-0-2-000000-0000000000000008","eid":10,"portnum":1,"port0":"ubc.1:7","iommufd":"iommufd1"}' \
